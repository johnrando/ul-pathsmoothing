<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PathSmoothingULCompat</AssemblyName>
    <RootNamespace>PathSmoothingULCompat</RootNamespace>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The mod is built in-place inside the game install. Override GameRoot on the
       command line to build against a copy elsewhere. -->
  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</GameRoot>
    <GameManaged>$(GameRoot)7DaysToDie_Data\Managed\</GameManaged>
    <BepInExCore>$(GameRoot)BepInEx\core\</BepInExCore>
  </PropertyGroup>

  <!-- No .NET Framework targeting pack is installed (and none is wanted: the mod runs
       on the game's own Mono BCL). Compile against the BCL shipped in Managed\. -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <FrameworkPathOverride>$(GameManaged)</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib" HintPath="$(GameManaged)mscorlib.dll" Private="false" />
    <Reference Include="System" HintPath="$(GameManaged)System.dll" Private="false" />
    <Reference Include="System.Core" HintPath="$(GameManaged)System.Core.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(GameManaged)netstandard.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)Assembly-CSharp.dll" Private="false" />
    <Reference Include="LogLibrary" HintPath="$(GameManaged)LogLibrary.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameManaged)UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- Stage a ready-to-copy mod folder next to the build output. -->
  <Target Name="StageMod" AfterTargets="Build">
    <PropertyGroup>
      <StageDir>$(MSBuildThisFileDirectory)..\..\dist\PathSmoothingULCompat\</StageDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)ModInfo.xml" DestinationFolder="$(StageDir)" />
    <Message Importance="high" Text="Staged mod folder: $(StageDir)" />
  </Target>

</Project>
